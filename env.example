# ======================================================================
# Toolbox 环境变量模板 — 复制为 .env 并填入实际值
# ======================================================================

# 部署 Webhook 密钥 (GitHub Settings → Webhooks → Secret)
DEPLOY_GITHUB_SECRET=your-github-webhook-secret

# 部署 Webhook 密码 (Gitee WebHooks → 密码)
DEPLOY_GITEE_TOKEN=your-gitee-webhook-password

# ======================================================================
# 项目指向说明（这些是服务器路径，不需要填到 .env）
# ======================================================================
# 前端构建部署目标:
#   /usr/share/nginx/html/nuxt-tools/tools/   (port 8999)
#   /usr/share/nginx/html/nuxt-tools/          (port 80 proxy)
#
# 后端服务:
#   systemd: unified-server.service
#   端口: 9200
#
# nginx 路由:
#   /ws         → 文件互传 WebSocket 信令
#   /tools/api/ → 留言板 API
#   /deploy/    → 自动部署 Webhook
